# Copy this file to .env and fill in your values
# Never commit .env to version control

# Port the server listens on
PORT=3000

# Allowed CORS origin — use * for all origins (dev only)
# In production, restrict to your frontend domain, e.g. https://myapp.com
CORS_ORIGIN=*

# SQLite database file path
# Local: shopping.db | Railway production: /data/shopping.db
DB_PATH=shopping.db

# Gemini AI configuration
# Get your key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Comma-separated fallback models if primary is unavailable (404/429/503)
GEMINI_FALLBACK_MODELS=gemini-1.5-flash,gemini-1.5-flash-8b,gemini-1.5-pro
