# Copy this file to .env and fill in your values
# Never commit .env to version control

# Port the server listens on
PORT=3000

# Allowed CORS origin — use * for all origins (dev only)
# In production, restrict to your frontend domain, e.g. https://myapp.com
CORS_ORIGIN=*

# SQLite database file path
# Local: shopping.db | Railway production: /data/shopping.db
DB_PATH=shopping.db

# OpenRouter AI configuration
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
# Comma-separated fallback models if primary is unavailable (404/429/502/503)
OPENROUTER_FALLBACK_MODELS=meta-llama/llama-3.3-70b-instruct:free,deepseek/deepseek-chat-v3-0324:free,mistralai/mistral-small-3.1-24b-instruct:free
# Optional ranking metadata (shown on openrouter.ai)
OPENROUTER_REFERER=http://localhost:3000
OPENROUTER_TITLE=PWAM Shopping List
