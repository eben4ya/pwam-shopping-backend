# Copy this file to .env and fill in your values
# Never commit .env to version control

# Port the server listens on
PORT=3000

# Allowed CORS origin — use * for all origins (dev only)
# In production, restrict to your frontend domain, e.g. https://myapp.com
CORS_ORIGIN=

# Turso (libSQL) connection — get values from `turso db show` + `turso db tokens create`
TURSO_DATABASE_URL=libsql://pwam-shopping-<your-org>.turso.io
TURSO_AUTH_TOKEN=

# Google OAuth client ID (from Google Cloud Console → APIs & Services → Credentials)
# Create a "Web application" OAuth 2.0 client ID
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# JWT signing secret — use a long random string in production
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret

# OpenRouter AI configuration
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Comma-separated fallback models if primary is unavailable (404/429/502/503)
# Verify availability at https://openrouter.ai/models?q=free
OPENROUTER_FALLBACK_MODELS=qwen/qwen3-next-80b-a3b-instruct:free,openai/gpt-oss-120b:free,z-ai/glm-4.5-air:free,deepseek/deepseek-v4-flash:free
# Optional ranking metadata (shown on openrouter.ai)
OPENROUTER_REFERER=http://localhost:3000
OPENROUTER_TITLE=PWAM Shopping List

# Vercel — used by POST /vercel/pause
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID_FE=
VERCEL_PROJECT_ID_BE=
